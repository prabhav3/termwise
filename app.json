{
  "expo": {
    "name": "Termwise",
    "slug": "termwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "termwise",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.prabhav3.termwise",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.prabhav3.termwise",
      "adaptiveIcon": {
        "backgroundColor": "#FFF4DE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF4DE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#141414",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Termwise adds your deadlines and study blocks to a calendar you choose, so your plan shows up next to the rest of your week.",
          "remindersPermission": "Termwise can add your deadlines to Reminders so you get nudged before they are due."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Termwise reads the syllabus or table-of-contents photos you pick so it can build your study plan.",
          "cameraPermission": "Termwise uses the camera to photograph a printed syllabus or a textbook's table of contents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
